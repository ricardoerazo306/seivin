# Copia este archivo como .env.local y completa los valores de tu proyecto de Supabase.
# Están en Supabase → Project Settings → API Keys.
#
# Estos dos valores son PÚBLICOS por diseño: viajan al navegador y la seguridad
# la ponen las políticas RLS de la base de datos.
# NUNCA pongas aquí la clave secreta (sb_secret_...) ni la service_role.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
